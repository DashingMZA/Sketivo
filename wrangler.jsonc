{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sitepins-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat_v2"],
  "workers_dev": false,
  "route": "api.sketivo.com/*",

  "durable_objects": {
    "bindings": [
      { "name": "API_DO", "class_name": "ApiDurableObject" },
      { "name": "REALTIME_DO", "class_name": "RealtimeDurableObject" }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["ApiDurableObject", "RealtimeDurableObject"]
    }
  ],

  "r2_buckets": [
    {
      "binding": "SITEPINS_BUCKET",
      "bucket_name": "sitepins-media"
    }
  ],

  "vars": {
    // App
    "NODE_ENV": "production",
    "BRAND_SLUG": "sitepins",
    "APP_URL": "https://sketivo.com",
    "BASE_URL": "https://api.sketivo.com",
    "GIT_APP_NAME": "",

    // Security
    "COOKIE_DOMAIN": ".sketivo.com",
    "CORS_ORIGINS": "https://sketivo.com",
    "TRUST_PROXY": "1",
    "REQUIRE_EMAIL_VERIFICATION": "true",

    // Mail
    "MAIL_PROVIDER": "resend",

    // Storage (R2 via S3 API)
    "S3_ENDPOINT": "https://b47987832efb7c85f4d5ec99f95048c1.r2.cloudflarestorage.com",
    "S3_REGION": "auto"
  }
}
