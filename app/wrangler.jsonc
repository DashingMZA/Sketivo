{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sketivo-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "routes": [
    {
      "pattern": "sketivo.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "AI_MODEL": "gemini-3.5-flash",
    "AI_PROVIDER": "gemini",
    "GITHUB_APP_CLIENT_ID": "Iv23li2tEN7NllxYgKnV",
    "GITHUB_APP_ID": "5737853",
    "NEXT_PUBLIC_BACKEND_URL": "https://api.sketivo.bond/api/v1",
    "NEXT_PUBLIC_BRAND_FAVICON": "/images/favicon.png",
    "NEXT_PUBLIC_BRAND_LOGO": "/images/logo.svg",
    "NEXT_PUBLIC_BRAND_LOGO_DARK": "/images/logo-white.svg",
    "NEXT_PUBLIC_BRAND_LOGO_HEIGHT": "40",
    "NEXT_PUBLIC_BRAND_LOGO_ICON": "/images/logo-icon.svg",
    "NEXT_PUBLIC_BRAND_LOGO_WIDTH": "136",
    "NEXT_PUBLIC_BRAND_NAME": "Sketivo",
    "NEXT_PUBLIC_BRAND_SLUG": "sketivo",
    "NEXT_PUBLIC_BRAND_URL": "https://sketivo.bond",
    "NEXT_PUBLIC_BUCKET_URL": "https://media.csofts.tech",
    "NEXT_PUBLIC_COMMUNITY_URL": "https://discord.gg/SPrfEnvxD",
    "NEXT_PUBLIC_DASHBOARD_HOME": "/dashboard/account",
    "NEXT_PUBLIC_DEMO_EMAIL": "zaheer@sketivo.bond",
    "NEXT_PUBLIC_DEMO_PASSWORD": "zaheer@123",
    "NEXT_PUBLIC_DOCS_URL": "https://docs.sketivo.bond",
    "NEXT_PUBLIC_GIT_APP_NAME": "sketivo",
    "NEXT_PUBLIC_HP_WS_URL": "wss://api.sketivo.bond/api/v1/editor/collab",
    "NEXT_PUBLIC_IS_DEMO": "false",
    "NEXT_PUBLIC_PRIVACY_URL": "https://sketivo.bond/privacy-policy",
    "NEXT_PUBLIC_SOURCE_URL": "https://github.com/dashingmza/sketivo",
    "NEXT_PUBLIC_STATUS_URL": "https://status.sketivo.bond",
    "NEXT_PUBLIC_SUPPORT_URL": "https://sketivo.bond/contact",
    "NEXT_PUBLIC_TERMS_URL": "https://sketivo.bond/terms",
    "NEXT_PUBLIC_UPDATES_URL": "https://updates.sketivo.bond"
  }
}
